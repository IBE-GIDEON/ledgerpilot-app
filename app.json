{
  "expo": {
    "name": "Lancer",
    "slug": "lancer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lancer",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/d5c0cfda-4d3f-4625-9733-613c63a386b2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ibegideon.lancer"
    },
    "android": {
      "package": "com.ibegideon.lancer",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#0B0B0C"
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "enableGooglePay": true
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0C",
          "dark": {
            "backgroundColor": "#0B0B0C"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "./plugins/with-skip-lint-vital",
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# Stripe pulls in Google Wallet push provisioning, which Lancer does not use.\n-dontwarn com.stripe.android.pushProvisioning.**\n"
          }
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "appTagline": "Money in, money out, across every bank.",
      "router": {},
      "eas": {
        "projectId": "d5c0cfda-4d3f-4625-9733-613c63a386b2"
      }
    },
    "owner": "gideonsnicks",
    "platforms": [
      "ios",
      "android"
    ]
  }
}
